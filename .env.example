# Public and internal ports
TRAEFIK_PORT=8080
BMKG_PORT=8081
PVMBG_PORT=8082
AGGREGATOR_PORT=8090
CLIENT_API_PORT=8080
AUTH_PORT=8091

# Independent source credentials
BMKG_API_KEY=example-bmkg-key
PVMBG_TOKEN=example-pvmbg-token

# Downstream authentication
JWT_SIGNING_KEY=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL_SECONDS=60
MEDIA_CLIENT_ID=media
MEDIA_CLIENT_SECRET=media-secret
FIELD_CLIENT_ID=field-team
FIELD_CLIENT_SECRET=field-secret
INTERNAL_CLIENT_ID=internal-ops
INTERNAL_CLIENT_SECRET=internal-secret

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=canonical
POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/canonical?sslmode=disable
AUTH_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/auth?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Polling and source simulation
POLL_INTERVAL_SECONDS=3
SOURCE_TIMEOUT_SECONDS=4
BMKG_DELAY_MS=100
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
EVENT_GENERATION_INTERVAL_SECONDS=10
SEED_RECORD_COUNT=20
